<Application x:Class="Hora.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Das Token-Wörterbuch (Farbwerte) fehlt hier absichtlich: ThemeManager fügt es zur
                    Laufzeit an Position 0 ein, je nach gespeicherter Theme-Einstellung. Theme.xaml
                    verweist per DynamicResource darauf, sodass der Dunkelmodus jederzeit umschalten kann.
                -->
                <ResourceDictionary Source="Styles/Theme.xaml"/>
                <!--
                    BoolToVisibility steht seit dem Asana-Block in Theme.xaml selbst: Die dortigen
                    Vorlagen brauchen ihn, und ein StaticResource-Verweis aus einer Vorlage heraus
                    findet nur, was in derselben Sammlung steht. Über diese Verknüpfung bleibt er
                    für alle Ansichten unverändert erreichbar.
                -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
