<Window x:Class="Hora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Hora.App.ViewModels"
        xmlns:views="clr-namespace:Hora.App.Views"
        Title="{Binding AppTitle}"
        Icon="Assets/hora.ico"
        Width="1000" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource CanvasBrush}">

    <!-- Randloses Fenster mit eigener Fensterleiste, Spec 3.1. CaptionHeight muss zur Höhe der
         selbstgebauten Leiste unten passen (40), sonst stimmt die Zieh-/Doppelklickfläche nicht. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fensterleiste. Alles außer den Schaltflächen bleibt Zieh-/Doppelklickfläche, weil nur
             die Schaltflächen WindowChrome.IsHitTestVisibleInChrome setzen (in Theme.xaml, über den
             Stil TitleBarButton).

             Die Pille zum Umschalten des Designs saß früher links neben den Fensterknöpfen. Sie ist
             entfallen: Das Design wird auf der Profilseite gewählt, dort mit drei Möglichkeiten
             (System, Hell, Dunkel) statt nur zwei. -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Ersetzt den grünen Platzhalterpunkt durch das Hora-Zeichen. Angegeben ist nur
                     die Höhe; die Breite ergibt sich aus dem Seitenverhältnis der Vorlage. -->
                <views:HoraLogo Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="Hora" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <!--
                    Die Fensterknöpfe zeichnen ihr Symbol als kleinen Vektorpfad statt als
                    Schriftzeichen aus "Segoe MDL2 Assets": Die PUA-Symbole dieser Schriftart kamen
                    im Startlauf nur als leere Kästchen ("Tofu") an, obwohl die Schriftart installiert
                    ist – ein bekannter DirectWrite/.NET-Eigenheit bei manchen Anzeigepfaden. Ein
                    selbst gezeichneter Pfad ist von jeder Schriftart unabhängig und deshalb
                    zuverlässiger. Stroke bindet an das Foreground der jeweiligen Schaltfläche, damit
                    der weiße Auslöser der Schließen-Schaltfläche (Style TitleBarButton) auch das
                    Symbol einfärbt.
                -->
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource TitleBarButton}"
                        Click="OnMinimizeClick"
                        ToolTip="Minimieren">
                    <Path Width="10" Height="10" Stretch="None"
                          Data="M0,5 L10,5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"/>
                </Button>
                <Button x:Name="MaximizeRestoreButton"
                        Style="{StaticResource TitleBarButton}"
                        Click="OnMaximizeRestoreClick"
                        ToolTip="Maximieren">
                    <Path x:Name="MaximizeRestoreGlyph" Width="10" Height="10" Stretch="None"
                          Data="M0,0 L10,0 L10,10 L0,10 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}"
                        Tag="Close"
                        Click="OnCloseClick"
                        ToolTip="Schließen">
                    <Path Width="10" Height="10" Stretch="None"
                          Data="M0,0 L10,10 M0,10 L10,0"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Inhalt: unveränderter Aufbau (Login oder Übersicht), nur im neuen Farbschema. -->
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentScreen}"/>
            <TextBlock Text="Anmeldung wird geprüft …"
                       Style="{StaticResource EmptyHint}"
                       Visibility="{Binding IsStarting, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Window>
