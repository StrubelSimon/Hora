<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Farbtoken dunkler Modus, Spec 2.2. Einzige Quelle für Farbwerte zusammen mit Tokens.Light.xaml. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#14361F"/>
    <SolidColorBrush x:Key="InkBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="InkSoftBrush" Color="#9CA3AF"/>
    <!--
        Angehoben von #6B7280 auf #8A94A3 (Abschlussprüfung, Befund K): Der alte Ton erreichte auf
        SurfaceBrush (#1F2430) nur 3,21:1 und war damit für die 10 Punkt großen
        Großbuchstaben-Beschriftungen der Kennzahlenkarte zu schwach. Der neue Ton erreicht 5,06:1
        auf SurfaceBrush und 5,38:1 auf StatsCardBrush (#1A1F29) und liegt weiterhin deutlich unter
        InkSoftBrush (6,11:1), sodass die Abstufung Ink > InkSoft > Muted erhalten bleibt. Der helle
        Modus bleibt unverändert.
    -->
    <SolidColorBrush x:Key="MutedBrush" Color="#8A94A3"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#374151"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#161A22"/>
    <SolidColorBrush x:Key="StatsCardBrush" Color="#1A1F29"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#252C38"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="#F87171"/>

    <!-- Die Ticketpalette ist entfallen, siehe Tokens.Light.xaml. -->

    <!--
        Altbestand-Kompatibilität: siehe Tokens.Light.xaml. Gleiche Schlüsselmenge, dunkle Werte.
    -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#161A22"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#374151"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FBBF24"/>

    <!-- Abdeckung hinter der Ladeanzeige, siehe Tokens.Light.xaml. Gleicher Schlüssel, dunkler Wert. -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#B3161A22"/>

    <!--
        Vordergrund auf kräftig gefüllter Fläche, siehe Tokens.Light.xaml. Gleicher Schlüssel und
        bewusst derselbe weiße Wert: AccentBrush (#22C55E) und NegativeBrush (#F87171) bleiben auch
        im dunklen Modus mitteldunkel genug, damit weiße Schrift darauf lesbar ist.
    -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

</ResourceDictionary>
