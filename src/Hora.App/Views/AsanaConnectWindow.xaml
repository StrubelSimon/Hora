<Window x:Class="Hora.App.Views.AsanaConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asana verbinden"
        Icon="pack://application:,,,/Hora;component/Assets/hora.ico"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}">

    <!--
        Datenkontext ist das AsanaConnectViewModel. Zwei Schritte übereinander im selben Gitter,
        deren Sichtbarkeit an IsTokenStep und IsWorkspaceStep hängt: Der jeweils andere ist
        Collapsed und zählt für SizeToContent="Height" nicht mit, das Fenster wächst und schrumpft
        also mit dem Schritt.

        Die Standardschaltfläche ist an den Schritt gebunden statt fest gesetzt. Zwei Schaltflächen
        mit IsDefault="True" im selben Fokusbereich stritten sich sonst darum, was die Eingabetaste
        auslöst — und in Schritt zwei wäre das „Weiter“ gewesen, das dort nichts mehr zu suchen hat.

        Die Rückfrage vor dem Trennen liegt auf der Profilseite, nicht hier: Dieses Fenster stellt
        eine Verbindung her, es löst keine.
    -->
    <Border Style="{StaticResource Card}" Margin="16" Padding="24">
        <Grid>

            <!-- ===================== Schritt 1: Token ===================== -->
            <StackPanel Visibility="{Binding IsTokenStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Asana verbinden" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Hora liest die erfassten Zeiten mit einem persönlichen Zugangstoken. Er wird verschlüsselt auf diesem Rechner abgelegt und nirgends sonst."
                           Foreground="{DynamicResource InkSoftBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <TextBlock Text="Persönlicher Zugangstoken" Style="{StaticResource FieldLabel}"/>
                <!-- Bewusst ein TextBox und kein PasswordBox: Ein Asana-Token wird aus der
                     Zwischenablage eingefügt und ist kein Kennwort, das jemand mitliest. Verdeckt
                     ließe sich ein verrutschtes Einfügen nicht erkennen. -->
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldTextBox}"/>

                <Button Content="Token erstellen"
                        Command="{Binding OpenTokenHelpCommand}"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource NegativeBrush}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <Button Content="{Binding ContinueButtonText}"
                        Command="{Binding ContinueCommand}"
                        IsDefault="{Binding IsTokenStep}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        MinWidth="140"
                        Margin="0,20,0,0"/>
            </StackPanel>

            <!-- ===================== Schritt 2: Workspace ===================== -->
            <StackPanel Visibility="{Binding IsWorkspaceStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Verbunden als" FontSize="18" FontWeight="SemiBold"/>

                <!-- Name und E-Mail stehen nur da, sie werden nicht abgefragt: Sie kommen von Asana
                     und sind damit geprüft, anders als etwas Eingetipptes. -->
                <TextBlock Text="{Binding UserName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,10,0,0"/>
                <TextBlock Text="{Binding UserEmail}"
                           Foreground="{DynamicResource InkSoftBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"/>

                <TextBlock Text="Workspace" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Workspaces}"
                          SelectedItem="{Binding SelectedWorkspace}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource FieldComboBox}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Zurück"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}"
                            MinWidth="100"/>
                    <Button Content="Verbinden"
                            Command="{Binding ConnectCommand}"
                            IsDefault="{Binding IsWorkspaceStep}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="140"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Border>
</Window>
