<UserControl x:Class="Hora.App.Views.DayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Datenkontext dieser Ansicht ist das DayViewModel. Aufbau nach Spec 3.4.
        Die Eintragsliste ist ein ItemsControl und kein DataGrid mehr: Ein DataGrid nimmt die
        Entf-Taste entgegen und entfernt damit Zeilen aus der gebundenen Sammlung, obwohl es nur
        anzeigen soll. Mit einem ItemsControl ist dieses Verhalten strukturell nicht mehr möglich.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Buchungen des Tages, Spec 3.4 ===================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Zeilenhöhe 44, mit Kommentar-Unterzeile 58 (Spec 2.4). -->
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="44"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasComment}" Value="True">
                                                    <Setter Property="Height" Value="58"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="116"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="72"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Farbiger Punkt und anklickbarer Ticket-Schlüssel in Ticketfarbe.
                                             Die Uhrzeitspalte wurde auf Wunsch des Auftraggebers entfernt;
                                             WorklogRow.TimeRangeText bleibt berechnet, falls sie zurückkehrt. -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Border Style="{StaticResource TicketDot}" Margin="0,0,8,0"/>
                                            <Button Content="{Binding IssueKey}"
                                                    Style="{StaticResource TicketKeyLink}"
                                                    Command="{Binding DataContext.OpenIssueCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding IssueUrl}"/>
                                        </StackPanel>

                                        <!-- Titel und, falls vorhanden, der Kommentar als graue Unterzeile.
                                             Beide einzeilig abgeschnitten, voller Text als Mauszeiger-Hinweis. -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding IssueSummary}"
                                                       ToolTip="{Binding IssueSummary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Comment}"
                                                       ToolTip="{Binding Comment}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource InkSoftBrush}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DurationText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Keine Buchungen an diesem Tag."
                           Style="{StaticResource EmptyHint}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- ===================== Abschnitt „Pro Ticket“, Spec 3.7 ===================== -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel.Style>
                <!-- Gibt es keine Buchungen, entfällt der Abschnitt vollständig. -->
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="PRO TICKET" Style="{StaticResource SectionLabel}" Margin="4,0,0,6"/>
            <Border Style="{StaticResource Card}" Padding="8,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="186">
                    <!-- Zwei Spalten, von links oben nach rechts unten gefüllt. -->
                    <!-- Grid.IsSharedSizeScope: hier liegt der Geltungsbereich der Spaltenbreiten aus
                         IssueTotalItemTemplate, damit alle Ticketzeilen dieselben Spalten teilen. -->
                    <ItemsControl ItemsSource="{Binding IssueTotals}"
                                  ItemTemplate="{StaticResource IssueTotalItemTemplate}"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
