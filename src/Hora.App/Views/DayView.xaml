<UserControl x:Class="Hora.App.Views.DayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Datenkontext dieser Ansicht ist das DayViewModel. Aufbau nach Spec 3.4.
        Die Eintragsliste ist ein ItemsControl und kein DataGrid mehr: Ein DataGrid nimmt die
        Entf-Taste entgegen und entfernt damit Zeilen aus der gebundenen Sammlung, obwohl es nur
        anzeigen soll. Mit einem ItemsControl ist dieses Verhalten strukturell nicht mehr möglich.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Buchungen des Tages, Spec 3.4 ===================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4">
                    <StackPanel>
                        <!-- Die Zeilenvorlage liegt seit dem Asana-Block als WorklogRowTemplate in
                             Styles/Theme.xaml: Beide Listen dieser Ansicht brauchen dieselbe, und
                             zwei Abschriften liefen unweigerlich auseinander. -->
                        <ItemsControl ItemsSource="{Binding Rows}"
                                      ItemTemplate="{StaticResource WorklogRowTemplate}"/>

                        <!-- Asana-Block: Asana kennt nur einen Tag, keine Uhrzeit. Die Einträge stehen
                             deshalb unter den chronologischen Jira-Buchungen und nicht zwischen ihnen,
                             wo sie eine Ordnung vortäuschten, die es nicht gibt. Die Zwischenüberschrift
                             trennt die beiden Quellen; ein Abzeichen je Zeile wäre hier doppelt
                             gemoppelt — anders als im Abschnitt „Pro Ticket“, wo beide Quellen nach
                             Dauer sortiert durcheinanderstehen. -->
                        <StackPanel Visibility="{Binding HasAsanaRows, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ASANA"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="16,14,0,6"/>
                            <ItemsControl ItemsSource="{Binding AsanaRows}"
                                          ItemTemplate="{StaticResource WorklogRowTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="Keine Buchungen an diesem Tag."
                           Style="{StaticResource EmptyHint}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- ===================== Abschnitt „Pro Ticket“, Spec 3.7 ===================== -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel.Style>
                <!-- Gibt es keine Buchungen, entfällt der Abschnitt vollständig. -->
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="PRO TICKET" Style="{StaticResource SectionLabel}" Margin="4,0,0,6"/>
            <Border Style="{StaticResource Card}" Padding="8,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="186">
                    <!-- Zwei Spalten, von links oben nach rechts unten gefüllt. -->
                    <!-- Grid.IsSharedSizeScope: hier liegt der Geltungsbereich der Spaltenbreiten aus
                         IssueTotalItemTemplate, damit alle Ticketzeilen dieselben Spalten teilen. -->
                    <ItemsControl ItemsSource="{Binding IssueTotals}"
                                  ItemTemplate="{StaticResource IssueTotalItemTemplate}"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
