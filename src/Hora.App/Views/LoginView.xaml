<UserControl x:Class="Hora.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Hora.App.Views">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Style="{StaticResource Card}">
            <StackPanel>
                <!-- Zeichen und Wortmarke in einer Zeile. Die Logohöhe ist auf die Versalhöhe der
                     28 Punkt großen Wortmarke abgestimmt, damit beide auf einer Linie stehen. -->
                <StackPanel Orientation="Horizontal">
                    <views:HoraLogo Height="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Hora" FontSize="28" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Anmeldung bei Jira Cloud" Foreground="{DynamicResource InkSoftBrush}" Margin="0,4,0,12"/>

                <TextBlock Text="Jira-URL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                <TextBlock Text="E-Mail" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"/>

                <TextBlock Text="API-Token" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="TokenBox" PasswordChanged="OnTokenChanged" Style="{StaticResource FieldPasswordBox}"/>

                <CheckBox Content="Angemeldet bleiben" IsChecked="{Binding RememberMe}" Margin="0,12,0,0"/>

                <Button Content="API-Token erstellen"
                        Command="{Binding OpenTokenHelpCommand}"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource NegativeBrush}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <Button Content="{Binding LoginButtonText}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
