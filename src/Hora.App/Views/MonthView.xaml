<UserControl x:Class="Hora.App.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Datenkontext dieser Ansicht ist das MonthViewModel. Aufbau nach Spec 3.6: links eine schmale
        Spalte „KW“ mit Kalenderwoche und Wochensumme, daneben sieben Tagesspalten „MO“ bis „SO“.
        Kopfzeile und Wochenzeilen teilen dieselbe Spaltenaufteilung (feste Breite links, der Rest
        über ein UniformGrid mit sieben gleich breiten Spalten), damit die Spalten übereinanderstehen.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Kalendergitter, Spec 3.6 ===================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Kopfzeile: KW, MO bis SO -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="KW" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    <UniformGrid Grid.Column="1" Rows="1" Columns="7">
                        <TextBlock Text="MO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="DI" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="MI" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="DO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="FR" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="SA" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="SO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                    </UniformGrid>
                </Grid>

                <!-- Wochenzeilen -->
                <!--
                    Streckverhalten wie in WeekView.xaml, siehe den dortigen ausführlichen
                    Kommentar: Gemessen wird mit unbegrenzter Höhe (Wunschhöhe = Anzahl
                    Wochenzeilen × MinHeight 48), gestreckt wird erst beim Anordnen, weil der
                    ScrollContentPresenter mit max(Wunschhöhe, Sichtfensterhöhe) anordnet. Das
                    Gitter füllt die Karte damit tatsächlich aus, solange der Platz reicht.
                -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Weeks}">
                        <ItemsControl.ItemsPanel>
                            <!-- Eine Spalte, gleich hohe Wochenzeilen: Das Gitter füllt die Karte genau aus. -->
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kalenderwoche und Wochensumme -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                                        <TextBlock Text="{Binding WeekNumber}" FontWeight="SemiBold" Foreground="{DynamicResource InkSoftBrush}"/>
                                        <TextBlock Text="{Binding WeekTotalText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Sieben Tageszellen -->
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!--
                                                    Der Befehl kommt über den umgebenden UserControl, nicht über
                                                    den ItemsControl: Der nächstgelegene ItemsControl ist hier der
                                                    innere (Datenkontext MonthWeekRow), der das Kommando nicht hat.
                                                -->
                                                <Button Style="{StaticResource MonthDayCellButton}"
                                                        Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid Margin="8,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Tageszahl; Tage außerhalb des Monats und abgewählte
                                                             Wochentage stehen blass. -->
                                                        <TextBlock Grid.Row="0" Text="{Binding DayNumber}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Grid.Row="1" Text="{Binding TotalText}" FontSize="11.5" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Schmaler Balken gegen das Tagessoll; außerhalb des
                                                             Monats und an abgewählten Tagen gibt es nichts zu
                                                             zeigen – dort ist das Tagessoll null. -->
                                                        <ProgressBar Grid.Row="2" Height="4" Value="{Binding BarRatio, Mode=OneWay}" Margin="0,4,0,0">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource RatioBar}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== Abschnitt „Pro Ticket“, Spec 3.7 ===================== -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel.Style>
                <!-- Gibt es keine Buchungen, entfällt der Abschnitt vollständig. -->
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="PRO TICKET" Style="{StaticResource SectionLabel}" Margin="4,0,0,6"/>
            <Border Style="{StaticResource Card}" Padding="8,4">
                <!--
                    Gegenprobe zu WeekView.xaml: Das Kalendergitter braucht im ungünstigsten Fall
                    sechs Wochenzeilen (6 × MinHeight 48 = 288) plus Kopfzeile 19 plus Kartenrand
                    und -polster 22, zusammen 329. Bei Startgröße stehen 494 zur Verfügung, der
                    Abschnitt selbst kostet 41 – bleiben bei MaxHeight 112 genau 341 für die Karte.
                    Das reicht auch für einen Sechs-Wochen-Monat. Der Wert bleibt deshalb bei 112;
                    er ist bewusst kleiner als die 140 der Wochenansicht, weil die Monatskarte mehr
                    Höhe braucht. In der laufenden App nachgesehen (September 2026, fünf Zeilen):
                    kein Rollbalken.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="112">
                    <!-- Zwei Spalten, von links oben nach rechts unten gefüllt. -->
                    <!-- Grid.IsSharedSizeScope: hier liegt der Geltungsbereich der Spaltenbreiten aus
                         IssueTotalItemTemplate, damit alle Ticketzeilen dieselben Spalten teilen. -->
                    <ItemsControl ItemsSource="{Binding IssueTotals}"
                                  ItemTemplate="{StaticResource IssueTotalItemTemplate}"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
