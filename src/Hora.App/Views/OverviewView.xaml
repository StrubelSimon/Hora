<UserControl x:Class="Hora.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Hora.App.Controls"
             xmlns:views="clr-namespace:Hora.App.Views">

    <!--
        Datenkontext dieser Ansicht ist das OverviewViewModel. Alle Farben kommen über
        DynamicResource aus den Token-Dateien; ein fester Farbwert steht nirgends in dieser Datei,
        sonst schaltet der Dunkelmodus an dieser Stelle nicht um.
        Aufbau nach Spec 3.2 (Kopfzeile) und 3.3 (Kennzahlenkarte); die drei Inhaltsansichten
        schließen sich über IsDayMode/IsWeekMode/IsMonthMode gegenseitig aus.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Kopfzeile, Spec 3.2 ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <!--
                    Die Pfeile ◄ und ► aus Spec 3.2 stehen als selbst gezeichneter Vektorpfad in der
                    Schaltfläche statt als Schriftzeichen: Montserrat kennt diese Zeichen nicht, sie kommen
                    dann aus einer Ersatzschrift und fallen in Größe und Gewicht aus dem Bild. Derselbe Weg
                    wie bei den Fensterknöpfen in MainWindow.xaml.
                -->
                <Button Style="{StaticResource NavArrowButton}" Command="{Binding PreviousCommand}">
                    <Path Data="M7,0 L0,5 L7,10 Z" Fill="{DynamicResource InkBrush}" Stretch="None"/>
                </Button>
                <TextBlock Text="{Binding PeriodLabel}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
                <Button Style="{StaticResource NavArrowButton}" Command="{Binding NextCommand}">
                    <Path Data="M0,0 L7,5 L0,10 Z" Fill="{DynamicResource InkBrush}" Stretch="None"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!--
                    Segmentschalter „Monat | Woche | Tag“. IsChecked ist bewusst OneWay: IsMonthMode,
                    IsWeekMode und IsDayMode sind nur lesbar, eine beidseitige Bindung liefe still ins
                    Leere. Den Wechsel löst das jeweilige Kommando aus, die Anzeige folgt danach dem
                    umgeschalteten Modus. Spec 2.4: Rahmen mit Radius 8, Segmente innen 6.
                -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Monat"
                                     GroupName="PeriodMode"
                                     Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsMonthMode, Mode=OneWay}"
                                     Command="{Binding ShowMonthCommand}"/>
                        <RadioButton Content="Woche"
                                     GroupName="PeriodMode"
                                     Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsWeekMode, Mode=OneWay}"
                                     Command="{Binding ShowWeekCommand}"/>
                        <RadioButton Content="Tag"
                                     GroupName="PeriodMode"
                                     Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsDayMode, Mode=OneWay}"
                                     Command="{Binding ShowDayCommand}"/>
                    </StackPanel>
                </Border>

                <Button Content="Heute" Style="{StaticResource GhostButton}" Command="{Binding TodayCommand}" Margin="10,0,0,0"/>
                <!--
                    „Aktualisieren“ steht nicht in Spec 3.2, ist aber die einzige Möglichkeit, für den
                    bereits geladenen Zeitraum neu bei Jira nachzufragen (alle anderen Wege nutzen den
                    Zwischenspeicher). Ohne diese Schaltfläche ginge eine vorhandene Funktion verloren.
                -->
                <Button Content="Aktualisieren" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>

                <!--
                    Avatar: Kreis in AccentBrush mit den Initialen. Der Klick öffnet jetzt die
                    Profilseite; abgemeldet wird dort, samt der bisherigen Rückfrage. Deshalb hier
                    eine reine Kommandobindung ohne Code-Behind – es gibt nichts mehr zu bestätigen.
                    LogoutCommand bleibt am OverviewViewModel bestehen und verhält sich unverändert.
                -->
                <Button Content="{Binding UserInitials}"
                        Style="{StaticResource AvatarButton}"
                        Command="{Binding ShowProfileCommand}"
                        Margin="12,0,0,0">
                    <Button.ToolTip>
                        <StackPanel>
                            <TextBlock Text="{Binding UserDisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="Profil öffnen" Foreground="{DynamicResource InkSoftBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Fehlerbanner ===================== -->
        <Border Grid.Row="1"
                Style="{StaticResource ErrorBanner}"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Erneut versuchen"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource NegativeBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <!-- ===================== Warnbanner bei Teilfehlern ===================== -->
        <Border Grid.Row="2"
                Style="{StaticResource WarningBanner}"
                Margin="0,0,0,12"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding WarningMessage}"
                       Foreground="{DynamicResource WarningTextBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ===================== Kennzahlenkarte, Spec 3.3 ===================== -->
        <Border Grid.Row="3" Style="{StaticResource StatsCard}" Padding="20,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="ERFASST" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Stats.LoggedText}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="SOLL" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Stats.TargetText}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="DIFFERENZ" Style="{StaticResource StatLabel}"/>
                        <!-- Negative Differenz in NegativeBrush, sonst InkBrush (aus StatValue geerbt). -->
                        <TextBlock Text="{Binding Stats.DifferenceText}" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stats.IsNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- In der Tagesansicht trägt dieser Balken die Zehnstundengrenze (rot); Woche und
                         Monat kennen sie nicht, dort bleibt es bei Grün und Orange. -->
                    <controls:SegmentedRatioBar Width="200"
                                                Segments="{Binding Stats.Segments, Mode=OneWay}"
                                                VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Stats.PercentText}"
                               FontWeight="SemiBold"
                               MinWidth="54"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Inhalt: Monat, Woche oder Tag ===================== -->
        <Grid Grid.Row="4">
            <!--
                Die Sichtbarkeit sitzt bewusst am umgebenden Grid und nicht an der Ansicht selbst:
                Die Ansicht trägt bereits den Datenkontext des jeweiligen Untermodells und kennt
                IsMonthMode/IsWeekMode/IsDayMode dort nicht mehr.
            -->
            <Grid Visibility="{Binding IsMonthMode, Converter={StaticResource BoolToVisibility}}">
                <views:MonthView DataContext="{Binding Month}"/>
            </Grid>
            <Grid Visibility="{Binding IsWeekMode, Converter={StaticResource BoolToVisibility}}">
                <views:WeekView DataContext="{Binding Week}"/>
            </Grid>
            <Grid Visibility="{Binding IsDayMode, Converter={StaticResource BoolToVisibility}}">
                <views:DayView DataContext="{Binding Day}"/>
            </Grid>
        </Grid>

        <!--
            Ladeanzeige über Kennzahlenkarte (Zeile 3) UND Inhalt (Zeile 4). Die Abdeckung liegt
            bewusst über beiden Zeilen: Der Zeitraumtitel wechselt sofort, die Kennzahlen erst nach
            dem Abruf. Läge die Abdeckung nur über dem Inhalt, stünden während jedes Ladens die
            Zahlen des alten Zeitraums sichtbar unter dem Titel des neuen (Befund B). Die Farbe
            kommt aus dem Token ScrimBrush.
        -->
        <Border Grid.Row="3"
                Grid.RowSpan="2"
                Background="{DynamicResource ScrimBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="6"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource AccentMutedBrush}"
                             BorderBrush="{DynamicResource HairlineBrush}"/>
                <TextBlock Text="Buchungen werden geladen …"
                           Foreground="{DynamicResource InkSoftBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
